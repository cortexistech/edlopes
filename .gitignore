# Para ignorar um arquivo específico (ex: um arquivo de configuração local)
.env
.DS_Store
# meu-rascunho.txt

# Para ignorar uma pasta inteira e tudo o que estiver dentro dela
vendor/
# node_modules/
# imagens-teste/

# Para ignorar todos os arquivos com uma determinada extensão
# *.log
# *.avif

# Dados de runtime (rate limiting do formulário)
storage/*.json

# Artefatos locais
__pycache__/
*.pyc